# ==============================================================================
# MedPaperPulse-AI Environment Configuration
# ==============================================================================

# --- AI Provider Configuration ---
# Choose provider: "gemini" (recommended) or "openai"
AI_PROVIDER=gemini

# Google Gemini API Configuration (via official google-genai SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI / Compatible API Configuration (optional alternative)
# If omitted or left empty, the application runs in a safe "Deterministic Grounded Engine"
# offline mode with sentence-level citation tagging, PICO classification, and zero hallucination.
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1

# --- PubMed / NCBI Ingestion Configuration ---
# Optional NCBI API key and tool contact email to increase NCBI E-Utilities rate limits (up to 10 req/s)
NCBI_API_KEY=
NCBI_EMAIL=medlitx@example.com

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
VITE_API_BASE_URL=http://localhost:8000/api
